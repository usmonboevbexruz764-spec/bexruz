.logo b{font-size:22px;line-height:18px}.logo small{display:block;font-size:9px;color:#9dc8ba;letter-spacing:1.3px}
nav{display:flex;gap:28px;font-size:14px;color:#d8e9e4}
nav a:first-child{color:#28dc82;border-bottom:2px solid #16c86b;padding-bottom:7px}
.phone{background:#09a95d;padding:11px 18px;border-radius:9px;font-size:13px;font-weight:700}
.menu{display:none;font-size:25px}

/* HERO */
.hero{min-height:430px;
   color:#fff;
   background-image: url("./metan.jpg");   
   background-repeat: no-repeat;
   background-size: cover;
   background-position: center;
}
.hero-inner{min-height:430px;display:flex;align-items:center}
.hero-copy{max-width:570px}
.badge{display:inline-block;background:#168a59;padding:8px 15px;border-radius:20px;font-size:13px;margin-bottom:15px}
.hero h1{font-size:52px;line-height:1.04;margin-bottom:12px}
.hero h1 span{color:#18ce72}
.hero p{font-size:17px;color:#d9ebe5;margin-bottom:25px}
.features{display:flex;gap:28px;flex-wrap:wrap;font-size:13px}
.features span{display:flex;align-items:center;gap:8px}.check{background:#138d5b;border-radius:50%;width:24px;height:24px;display:grid;place-items:center}

/* FUEL */
.fuel-section{margin-top:-45px;position:relative;z-index:2}
.fuel-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
.card{background:#fff;border:1px solid var(--border);border-radius:13px;box-shadow:0 5px 18px #073d2b10;padding:20px}
.fuel-card{min-height:185px}
.fuel-top{display:flex;align-items:center;gap:14px}
.nozzle{width:50px;height:65px;font-size:45px}
.metan{color:#08a85a}.propan{color:#1878d1}.benzin{color:#e52934}.dizel{color:#d99b10}
.fuel-name{font-weight:800;font-size:18px}
.status{font-size:10px;background:#e9faef;color:#0a9d58;padding:4px 7px;border-radius:10px;margin-left:5px}
.status.off{background:#fff2df;color:#c88000}
.fuel-info{font-size:12px;color:#81948e;margin:10px 0 14px}
.btn{width:100%;border:0;border-radius:7px;padding:11px;color:#fff;background:#09a95d;font-weight:700;cursor:pointer}
.btn.blue{background:#1679d4}.btn.red{background:#e3232d}.btn.yellow{background:#dca30d}

/* INFO */
.info-grid{display:grid;grid-template-columns:1fr 1.15fr .95fr;gap:18px;margin:20px 0}
.title{font-size:18px;font-weight:800;margin-bottom:13px}
.live{float:right;color:#08a85a;font-size:12px}
.queue-row{display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid #edf2f0;font-size:13px}
.queue-row span:last-child{color:#6e8980}
.map{height:170px;background:#e8eee9;border-radius:10px;position:relative;overflow:hidden}
.map:before{content:"";position:absolute;inset:0;background:linear-gradient(35deg,transparent 40%,#fff 41%,#fff 43%,transparent 44%),linear-gradient(120deg,transparent 49%,#d2dfd9 50%,#d2dfd9 52%,transparent 53%)}
.pin{position:absolute;left:52%;top:45%;font-size:30px}
.contact{background:linear-gradient(145deg,#006d4d,#003a2b);color:white}
.contact h3{font-size:21px;margin-bottom:8px}.contact p{font-size:12px;color:#c8e3da;margin:7px 0}

/* CALCULATOR */
.calc{background:#e9f8f2;margin-top:20px;padding:35px 0}
.calc-grid{display:grid;grid-template-columns:1.1fr 1fr;gap:30px;align-items:center}
.calc h2{font-size:27px}.calc p{font-size:13px;color:#6e8980;margin:8px 0 18px}
.fields{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.field{background:white;border:1px solid #dfeae5;border-radius:8px;padding:11px}
.field label{display:block;font-size:11px;color:#78918a}.field input{width:100%;border:0;outline:0;font-size:16px;margin-top:5px}
.results{display:grid;grid-template-columns:1fr 1fr;gap:15px}
.result{background:white;padding:20px;border-radius:10px;border-top:4px solid #08a85a}
.result.blue{border-color:#1679d4}.result strong{font-size:20px;display:block;margin:5px 0}.cheap{font-size:12px;color:#08a85a}

/* SECTIONS */
section{padding:45px 0}
.section-head{text-align:left;margin-bottom:22px}.section-head h2{font-size:25px}.section-head p{font-size:13px;color:#82958f}
.service-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:14px}
.service{background:#fff;border:1px solid var(--border);border-radius:11px;text-align:center;padding:22px 10px}
.icon{font-size:28px;color:#0ba95e;margin-bottom:8px}.service h4{font-size:13px}.service p{font-size:10px;color:#81938d;margin-top:4px}
.pay-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.pay-card{background:#fff;border:1px solid var(--border);border-radius:12px;padding:20px;display:flex;align-items:center;gap:20px}.pay-logo{font-weight:900;font-size:22px}.pay-card p{font-size:12px;color:#81938d}
.gallery{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
.gallery div{height:150px;border-radius:10px;background-size:cover;background-position:center}
.g1{background-image:url("https://images.unsplash.com/photo-1601584115197-04ecc0da31d8?auto=format&fit=crop&w=700&q=80")}
.g2{background-image:url("https://images.unsplash.com/photo-1601584115197-04ecc0da31d8?auto=format&fit=crop&w=700&q=80")}
.g3{background-image:url("https://images.unsplash.com/photo-1609521263047-f8f205293f24?auto=format&fit=crop&w=700&q=80")}
.g4{background-image:url("https://images.unsplash.com/photo-1560179707-f14e90ef3623?auto=format&fit=crop&w=700&q=80")}
.reviews{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.review{background:#fff;border:1px solid var(--border);padding:20px;border-radius:12px}.review p{font-size:13px;color:#607970}.stars{color:#f5b900;margin:7px 0}

/* FOOTER */
footer{background:#002c22;color:#d7ebe5;padding:40px 0 20px}.footer-grid{display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr;gap:30px}.footer h3{color:white;margin-bottom:12px}.footer p,.footer a{font-size:12px;color:#9ebdb4;display:block;margin:7px 0}.copy{border-top:1px solid #31574e;margin-top:25px;padding-top:15px;font-size:10px;color:#77968d}

/* RESPONSIVE */
