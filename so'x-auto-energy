}
body{font-family:Inter,Arial,sans-serif;background:#f7faf9;color:var(--text);line-height:1.45}
a{text-decoration:none;color:inherit}
button,input{font:inherit}
.container{width:min(1180px,92%);margin:auto}

/* HEADER */
