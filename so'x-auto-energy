   <p style="font-size:12px;color:#81938d;margin-bottom:10px">Toshkent viloyati, Bo‘stonliq tumani,<br>Farg‘ona viloyati, SO‘X tumani soy massivi</p>

   <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.css">
   <div id="soxMap" style="height:230px;border-radius:10px;overflow:hidden;isolation:isolate;background:#e8eee9"></div>
   <div id="soxMapInfo" style="font-size:12px;color:#81938d;margin-top:8px">📡 Joylashuvingiz aniqlanmoqda...</div>

   <div style="display:flex;gap:8px;margin-top:10px;flex-wrap:wrap">
    <a href="#" id="soxBtnNavi" onclick="soxOpenNavi();return false;"
       style="flex:1;min-width:120px;text-align:center;background:#fc3f1d;color:#fff;padding:10px;border-radius:7px;font-size:12px;font-weight:700">
       🧭 Yandex Navigator
    </a>
    <a href="#" id="soxBtnYandex" target="_blank" rel="noopener"
       style="flex:1;min-width:120px;text-align:center;background:#ffcc00;color:#222;padding:10px;border-radius:7px;font-size:12px;font-weight:700">
       🗺 Yandex Xarita
    </a>
    <a href="#" id="soxBtnGoogle" target="_blank" rel="noopener"
       style="flex:1;min-width:120px;text-align:center;background:#09a95d;color:#fff;padding:10px;border-radius:7px;font-size:12px;font-weight:700">
       📍 Google Xarita
    </a>
   </div>

   <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.js"></script>
   <script>
   /* ===== SHOXOBCHA KOORDINATASI (faqat shu yerda o'zgartiriladi) ===== */
   var SOX_LAT = 39.955986;
   var SOX_LON = 71.129792;
   /* =================================================================== */

   var soxUser = null;

   function soxLinks(){
    var y = "https://yandex.com/maps/?rtt=auto&rtext=" + (soxUser ? soxUser.lat+","+soxUser.lon : "") + "~" + SOX_LAT + "," + SOX_LON;
    var g = "https://www.google.com/maps/dir/?api=1&destination=" + SOX_LAT + "," + SOX_LON + (soxUser ? "&origin="+soxUser.lat+","+soxUser.lon : "");
    document.getElementById("soxBtnYandex").href = y;
    document.getElementById("soxBtnGoogle").href = g;
   }
   soxLinks();

   function soxOpenNavi(){
    var web = document.getElementById("soxBtnYandex").href;
    var app = "yandexnavi://build_route_on_map?lat_to=" + SOX_LAT + "&lon_to=" + SOX_LON;
    if(soxUser){ app += "&lat_from=" + soxUser.lat + "&lon_from=" + soxUser.lon; }
    var t = setTimeout(function(){ window.location.href = web; }, 1500);
    document.addEventListener("visibilitychange", function(){ clearTimeout(t); });
    window.location.href = app;
   }

   (function(){
    if(typeof L === "undefined"){
     document.getElementById("soxMapInfo").textContent = "Xaritani yuklab bo'lmadi. Pastdagi tugmalardan foydalaning.";
     return;
    }
    var map = L.map("soxMap").setView([SOX_LAT, SOX_LON], 14);
    L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
     maxZoom: 19, attribution: "© OpenStreetMap"
    }).addTo(map);

    var soxIcon = L.divIcon({className:"", html:'<div style="font-size:30px;line-height:30px;margin:-30px 0 0 -15px">📍</div>', iconSize:[30,30]});
    L.marker([SOX_LAT, SOX_LON], {icon: soxIcon}).addTo(map).bindPopup("<b>SO'X AUTO ENERGY</b>");

    var info = document.getElementById("soxMapInfo");
    var userMarker = null, routeLayer = null, routed = false;

    function drawRoute(){
     if(routed || !soxUser) return;
     routed = true;
     var url = "https://router.project-osrm.org/route/v1/driving/" + soxUser.lon + "," + soxUser.lat + ";" + SOX_LON + "," + SOX_LAT + "?overview=full&geometries=geojson";
     fetch(url).then(function(r){ return r.json(); }).then(function(d){
      if(!d.routes || !d.routes.length) return;
      var r = d.routes[0];
      routeLayer = L.geoJSON(r.geometry, {style:{color:"#1679d4", weight:5, opacity:.85}}).addTo(map);
      map.fitBounds(routeLayer.getBounds(), {padding:[25,25]});
      info.innerHTML = "🚗 Masofa: <b>" + (r.distance/1000).toFixed(1) + " km</b> · Taxminan <b>" + Math.round(r.duration/60) + " daqiqa</b>";
     }).catch(function(){});
    }

    function onPos(pos){
     soxUser = {lat: pos.coords.latitude, lon: pos.coords.longitude};
     soxLinks();
     if(!userMarker){
      userMarker = L.circleMarker([soxUser.lat, soxUser.lon], {radius:9, color:"#fff", weight:3, fillColor:"#1679d4", fillOpacity:1}).addTo(map).bindPopup("Siz shu yerdasiz");
      map.fitBounds([[soxUser.lat, soxUser.lon],[SOX_LAT, SOX_LON]], {padding:[30,30]});
      info.textContent = "📍 Joylashuvingiz aniqlandi. Yo'l qidirilmoqda...";
      drawRoute();
     } else {
      userMarker.setLatLng([soxUser.lat, soxUser.lon]);
     }
    }
    function onErr(){
     info.textContent = "Joylashuvga ruxsat berilmadi. Navigator tugmasi baribir telefoningizdagi joyingizdan yo'l quradi.";
    }
    if(navigator.geolocation){
     navigator.geolocation.watchPosition(onPos, onErr, {enableHighAccuracy:true, maximumAge:10000, timeout:15000});
    } else { onErr(); }
   })();
   </script>
